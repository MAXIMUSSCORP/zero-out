# Nebius Token Factory (OpenAI-compatible)
TF_API_KEY=
TF_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_NANO=
MODEL_SUPER=

# Local speech recognition (NVIDIA Parakeet via sherpa-onnx), a folder with encoder/decoder/joiner .onnx and tokens.txt
ASR_MODEL_DIR=models/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8

# Twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_VERIFY_SID=

# Limits and storage
DAILY_CAP_USD=5
RATE_PER_MIN=0.014
DB_PATH=data/zeroout.db
AUDIO_DIR=data/audio

# Session cookie signing
# Required, at least 32 chars. Generate with:
#   python -c 'import secrets;print(secrets.token_urlsafe(48))'
SESSION_SECRET=

# Cookies are HTTPS-only by default. Set COOKIE_SECURE=0 for local http development.
COOKIE_SECURE=1
